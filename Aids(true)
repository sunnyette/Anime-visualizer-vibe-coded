<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>BPM Mobile Visualizer & VJ Studio</title>
    <style>
        :root {
            --bg-color: #0b0d12;
            --panel-bg: rgba(18, 22, 31, 0.75);
            --panel-border: rgba(255, 255, 255, 0.12);
            --accent-cyan: #00f3ff;
            --accent-magenta: #ff0055;
            --accent-green: #00ff88;
            --text-main: #f0f4f8;
            --text-dim: #94a3b8;
            --radius-md: 12px;
            --radius-sm: 8px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: var(--bg-color);
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: var(--text-main);
        }

        /* Video Background Layers */
        .video-layer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0;
            transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1);
            z-index: 1;
        }

        .video-layer.active {
            opacity: 1;
            z-index: 2;
        }

        /* Canvas Overlay */
        #visualizer-canvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 3;
            pointer-events: none;
        }

        /* UI Layer */
        #ui-root {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 16px;
            pointer-events: none;
        }

        .interactive {
            pointer-events: auto;
        }

        /* Glassmorphism Panels */
        .panel {
            background: var(--panel-bg);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid var(--panel-border);
            border-radius: var(--radius-md);
            padding: 14px;
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
        }

        /* Top Bar */
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .app-title {
            font-size: 1.1rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            background: linear-gradient(45deg, var(--accent-cyan), var(--accent-magenta));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Controls Panel */
        .bottom-panel {
            display: flex;
            flex-direction: column;
            gap: 12px;
            max-height: 70vh;
            overflow-y: auto;
            transition: transform 0.3s ease, opacity 0.3s ease;
        }

        .bottom-panel.collapsed {
            transform: translateY(calc(100% - 48px));
            opacity: 0.9;
        }

        .panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
            padding-bottom: 8px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .control-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
            gap: 10px;
            margin-top: 8px;
        }

        /* UI Components */
        .btn {
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            padding: 10px 14px;
            border-radius: var(--radius-sm);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all 0.2s ease;
            text-align: center;
        }

        .btn:hover, .btn:active {
            background: rgba(255, 255, 255, 0.18);
            border-color: var(--accent-cyan);
        }

        .btn-accent {
            background: linear-gradient(135deg, rgba(0,243,255,0.2), rgba(255,0,85,0.2));
            border-color: var(--accent-cyan);
        }

        .btn-active {
            background: var(--accent-cyan) !important;
            color: #000 !important;
            box-shadow: 0 0 12px var(--accent-cyan);
        }

        .btn-danger {
            border-color: var(--accent-magenta);
            color: var(--accent-magenta);
        }

        .btn-danger.recording {
            background: var(--accent-magenta);
            color: #fff;
            animation: pulse 1.5s infinite;
        }

        @keyframes pulse {
            0% { opacity: 1; }
            50% { opacity: 0.5; }
            100% { opacity: 1; }
        }

        .slider-group {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .slider-group label {
            font-size: 0.75rem;
            color: var(--text-dim);
            display: flex;
            justify-content: space-between;
        }

        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 6px;
            border-radius: 3px;
            background: rgba(255, 255, 255, 0.15);
            outline: none;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--accent-cyan);
            cursor: pointer;
        }

        select {
            background: rgba(0, 0, 0, 0.4);
            border: 1px solid var(--panel-border);
            color: var(--text-main);
            padding: 8px 10px;
            border-radius: var(--radius-sm);
            outline: none;
            font-size: 0.85rem;
        }

        .file-input-wrapper {
            position: relative;
            overflow: hidden;
            display: inline-block;
        }

        .file-input-wrapper input[type="file"] {
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .bpm-display {
            font-family: monospace;
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--accent-green);
        }

        /* Status Badge */
        .badge {
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            background: rgba(255,255,255,0.1);
        }

        .badge-live { background: rgba(0, 255, 136, 0.2); color: var(--accent-green); }

        /* Responsive Tweaks */
        @media (max-width: 600px) {
            #ui-root { padding: 10px; }
            .control-grid { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body>

    <!-- Dual Video Crossfader Layers -->
    <video id="bg-video-1" class="video-layer active" muted playsinline loop></video>
    <video id="bg-video-2" class="video-layer" muted playsinline loop></video>

    <!-- Visualizer Canvas -->
    <canvas id="visualizer-canvas"></canvas>

    <!-- Offscreen canvas for color extraction -->
    <canvas id="offscreen-canvas" width="16" height="16" style="display:none;"></canvas>

    <!-- UI Overlay Layer -->
    <div id="ui-root">
        <!-- Top Navigation / Status -->
        <div class="top-bar panel interactive">
            <div class="app-title">BPM VJ Studio</div>
            <div style="display: flex; gap: 8px; align-items: center;">
                <span id="color-badge" class="badge">Harmonic Color</span>
                <span id="bpm-badge" class="bpm-display">120 BPM</span>
            </div>
        </div>

        <!-- Controls Drawer -->
        <div id="bottom-drawer" class="bottom-panel panel interactive">
            <div class="panel-header" id="drawer-toggle">
                <span style="font-size: 0.9rem; font-weight: 600;">🎛️ VJ Control Deck</span>
                <span id="collapse-icon">▼</span>
            </div>

            <!-- Audio Deck -->
            <div class="control-grid">
                <div class="file-input-wrapper btn btn-accent">
                    🎵 Load Audio
                    <input type="file" id="audio-file-input" accept="audio/*">
                </div>
                <button id="mic-btn" class="btn">🎤 Live Mic Input</button>
                <button id="tap-tempo-btn" class="btn btn-accent">🥁 Tap Tempo</button>
                <button id="play-btn" class="btn">▶️ Play Audio</button>
            </div>

            <!-- Video Deck -->
            <div class="control-grid">
                <div class="file-input-wrapper btn">
                    🎬 Load Videos (Multi)
                    <input type="file" id="video-file-input" accept="video/*" multiple>
                </div>
                <button id="trigger-video-btn" class="btn">🔀 Next Video</button>
                <button id="auto-swap-btn" class="btn">🔄 Auto Swap: OFF</button>
                <button id="record-btn" class="btn btn-danger">🔴 Record Mix</button>
            </div>

            <!-- Visualizer Tweaks -->
            <div class="control-grid">
                <div class="slider-group">
                    <label>Visualizer Mode</label>
                    <select id="viz-mode-select">
                        <option value="ring">Smooth Ring</option>
                        <option value="line">Sharp Line</option>
                        <option value="bars">Spectrum Bars</option>
                        <option value="particles">Particle Physics</option>
                    </select>
                </div>

                <div class="slider-group">
                    <label>Bass Trigger Sensitivity <span id="sens-val">180</span></label>
                    <input type="range" id="sens-slider" min="100" max="240" value="180">
                </div>

                <div class="slider-group">
                    <label>Canvas Visual Scale <span id="scale-val">1.0</span></label>
                    <input type="range" id="scale-slider" min="0.5" max="2.5" step="0.1" value="1.0">
                </div>
            </div>
        </div>
    </div>

    <script>
        /**
         * BPM Mobile Visualizer & VJ Studio - Core Engine
         */

        // --- IndexedDB Manager for Media Persistence ---
        class MediaStorage {
            constructor() {
                this.dbName = 'BPMVisualizerMediaDB';
                this.db = null;
            }

            async init() {
                return new Promise((resolve, reject) => {
                    const request = indexedDB.open(this.dbName, 1);
                    request.onupgradeneeded = (e) => {
                        const db = e.target.result;
                        if (!db.objectStoreNames.contains('videos')) db.createObjectStore('videos', { keyPath: 'id' });
                        if (!db.objectStoreNames.contains('audio')) db.createObjectStore('audio', { keyPath: 'id' });
                    };
                    request.onsuccess = (e) => {
                        this.db = e.target.result;
                        resolve();
                    };
                    request.onerror = (e) => reject(e);
                });
            }

            async saveItem(storeName, item) {
                if (!this.db) return;
                const tx = this.db.transaction(storeName, 'readwrite');
                tx.objectStore(storeName).put(item);
            }

            async getAllItems(storeName) {
                if (!this.db) return [];
                return new Promise((resolve) => {
                    const tx = this.db.transaction(storeName, 'readonly');
                    const store = tx.objectStore(storeName);
                    const request = store.getAll();
                    request.onsuccess = () => resolve(request.result || []);
                });
            }
        }

        // --- Color Harmonics Classifier ---
        const COLOR_GROUPS = ['Red', 'Orange', 'Yellow', 'Green', 'Cyan', 'Blue', 'Purple', 'Pink'];
        const COLOR_NEIGHBORS = {
            'Red': ['Pink', 'Orange', 'Red'],
            'Orange': ['Red', 'Yellow', 'Orange'],
            'Yellow': ['Orange', 'Green', 'Yellow'],
            'Green': ['Yellow', 'Cyan', 'Green'],
            'Cyan': ['Green', 'Blue', 'Cyan'],
            'Blue': ['Cyan', 'Purple', 'Blue'],
            'Purple': ['Blue', 'Pink', 'Purple'],
            'Pink': ['Purple', 'Red', 'Pink']
        };

        function rgbToHsl(r, g, b) {
            r /= 255; g /= 255; b /= 255;
            let max = Math.max(r, g, b), min = Math.min(r, g, b);
            let h, s, l = (max + min) / 2;
            if (max === min) {
                h = s = 0;
            } else {
                let d = max - min;
                s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
                switch (max) {
                    case r: h = (g - b) / d + (g < b ? 6 : 0); break;
                    case g: h = (b - r) / d + 2; break;
                    case b: h = (r - g) / d + 4; break;
                }
                h /= 6;
            }
            return [h * 360, s, l];
        }

        function getHueGroup(hue) {
            if (hue < 15 || hue >= 345) return 'Red';
            if (hue < 45) return 'Orange';
            if (hue < 70) return 'Yellow';
            if (hue < 160) return 'Green';
            if (hue < 200) return 'Cyan';
            if (hue < 260) return 'Blue';
            if (hue < 310) return 'Purple';
            return 'Pink';
        }

        // --- Audio Engine ---
        class AudioEngine {
            constructor() {
                this.ctx = null;
                this.analyser = null;
                this.audioElement = new Audio();
                this.audioElement.crossOrigin = "anonymous";
                this.audioElement.loop = true;
                this.sourceNode = null;
                this.micStream = null;
                this.destNode = null;
                this.isMic = false;
                this.freqData = null;
                this.timeData = null;
            }

            init() {
                if (this.ctx) return;
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                this.ctx = new AudioCtx();
                this.analyser = this.ctx.createAnalyser();
                this.analyser.fftSize = 256;
                this.analyser.smoothingTimeConstant = 0.8;

                this.destNode = this.ctx.createMediaStreamDestination();
                this.freqData = new Uint8Array(this.analyser.frequencyBinCount);
                this.timeData = new Uint8Array(this.analyser.fftSize);

                this.sourceNode = this.ctx.createMediaElementSource(this.audioElement);
                this.sourceNode.connect(this.analyser);
                this.analyser.connect(this.ctx.destination);
                this.analyser.connect(this.destNode);
            }

            async useMic() {
                this.init();
                if (this.ctx.state === 'suspended') await this.ctx.resume();

                if (this.isMic) {
                    this.stopMic();
                    return false;
                }

                try {
                    this.micStream = await navigator.mediaDevices.getUserMedia({ audio: true, video: false });
                    this.micSource = this.ctx.createMediaStreamSource(this.micStream);
                    this.micSource.connect(this.analyser);
                    this.audioElement.pause();
                    this.isMic = true;
                    return true;
                } catch (err) {
                    console.error("Microphone access denied", err);
                    return false;
                }
            }

            stopMic() {
                if (this.micStream) {
                    this.micStream.getTracks().forEach(track => track.stop());
                    this.micStream = null;
                }
                this.isMic = false;
            }

            loadAudioFile(url) {
                this.init();
                this.stopMic();
                this.audioElement.src = url;
            }

            togglePlay() {
                this.init();
                if (this.ctx.state === 'suspended') this.ctx.resume();

                if (this.audioElement.paused) {
                    this.audioElement.play();
                    return true;
                } else {
                    this.audioElement.pause();
                    return false;
                }
            }

            updateData() {
                if (!this.analyser) return;
                this.analyser.getByteFrequencyData(this.freqData);
                this.analyser.getByteTimeDomainData(this.timeData);
            }
        }

        // --- Main Application Controller ---
        class VJStudioApp {
            constructor() {
                this.storage = new MediaStorage();
                this.audio = new AudioEngine();
                
                // UI Elements
                this.v1 = document.getElementById('bg-video-1');
                this.v2 = document.getElementById('bg-video-2');
                this.canvas = document.getElementById('visualizer-canvas');
                this.ctx = this.canvas.getContext('2d');
                this.offCanvas = document.getElementById('offscreen-canvas');
                this.offCtx = this.offCanvas.getContext('2d');

                // App State
                this.videoClips = []; // Objects: { url, colorGroup, hue }
                this.activeSlot = 1;
                this.currentClipIndex = -1;
                this.autoSwap = false;
                this.bpm = 120;
                this.tapTimes = [];
                this.bassThreshold = 180;
                this.visualScale = 1.0;
                this.vizMode = 'ring';
                this.lastBeatTime = 0;
                this.beatCooldown = 250; // ms
                this.particles = [];

                // Recording
                this.mediaRecorder = null;
                this.recordedChunks = [];
                this.isRecording = false;

                // Bindings
                this.render = this.render.bind(this);
            }

            async init() {
                await this.storage.init();
                this.resizeCanvas();
                window.addEventListener('resize', () => this.resizeCanvas());

                this.setupEvents();
                this.initParticles();
                this.loadStoredMedia();

                // Generate procedural default fallback gradient video effect if no clips loaded
                this.setupDefaultCanvasVideoFallback();

                requestAnimationFrame(this.render);
            }

            resizeCanvas() {
                const dpr = window.devicePixelRatio || 1;
                this.canvas.width = window.innerWidth * dpr;
                this.canvas.height = window.innerHeight * dpr;
            }

            setupDefaultCanvasVideoFallback() {
                if (this.videoClips.length === 0) {
                    // Placeholder visual background if no video loaded
                    document.body.style.background = 'radial-gradient(circle at center, #1a1c29 0%, #08090c 100%)';
                }
            }

            async loadStoredMedia() {
                const storedVideos = await this.storage.getAllItems('videos');
                for (let item of storedVideos) {
                    const blobUrl = URL.createObjectURL(item.blob);
                    const colorData = await this.extractVideoColor(blobUrl);
                    this.videoClips.push({ url: blobUrl, ...colorData });
                }
                if (this.videoClips.length > 0) {
                    this.triggerVideoSwitch(0);
                }
            }

            setupEvents() {
                // UI Drawer Toggle
                const drawer = document.getElementById('bottom-drawer');
                document.getElementById('drawer-toggle').addEventListener('click', () => {
                    drawer.classList.toggle('collapsed');
                    document.getElementById('collapse-icon').innerText = drawer.classList.contains('collapsed') ? '▲' : '▼';
                });

                // Audio Inputs
                document.getElementById('audio-file-input').addEventListener('change', (e) => {
                    const file = e.target.files[0];
                    if (file) {
                        const url = URL.createObjectURL(file);
                        this.audio.loadAudioFile(url);
                        this.audio.audioElement.play();
                        document.getElementById('play-btn').innerText = '⏸️ Pause Audio';
                        this.storage.saveItem('audio', { id: Date.now(), blob: file });
                    }
                });

                document.getElementById('mic-btn').addEventListener('click', async () => {
                    const active = await this.audio.useMic();
                    const btn = document.getElementById('mic-btn');
                    if (active) {
                        btn.classList.add('btn-active');
                        btn.innerText = '🎤 Mic Active';
                    } else {
                        btn.classList.remove('btn-active');
                        btn.innerText = '🎤 Live Mic Input';
                    }
                });

                document.getElementById('play-btn').addEventListener('click', () => {
                    const playing = this.audio.togglePlay();
                    document.getElementById('play-btn').innerText = playing ? '⏸️ Pause Audio' : '▶️ Play Audio';
                });

                // Tap Tempo
                document.getElementById('tap-tempo-btn').addEventListener('click', () => {
                    this.registerTapTempo();
                });

                // Video File Input
                document.getElementById('video-file-input').addEventListener('change', async (e) => {
                    const files = Array.from(e.target.files);
                    for (let file of files) {
                        const blobUrl = URL.createObjectURL(file);
                        const colorData = await this.extractVideoColor(blobUrl);
                        this.videoClips.push({ url: blobUrl, ...colorData });
                        this.storage.saveItem('videos', { id: file.name + Date.now(), blob: file });
                    }
                    if (this.currentClipIndex === -1 && this.videoClips.length > 0) {
                        this.triggerVideoSwitch(0);
                    }
                });

                document.getElementById('trigger-video-btn').addEventListener('click', () => {
                    this.triggerHarmonicVideoSwitch();
                });

                document.getElementById('auto-swap-btn').addEventListener('click', () => {
                    this.autoSwap = !this.autoSwap;
                    const btn = document.getElementById('auto-swap-btn');
                    btn.innerText = `🔄 Auto Swap: ${this.autoSwap ? 'ON' : 'OFF'}`;
                    btn.classList.toggle('btn-active', this.autoSwap);
                });

                // Controls
                document.getElementById('sens-slider').addEventListener('input', (e) => {
                    this.bassThreshold = parseInt(e.target.value);
                    document.getElementById('sens-val').innerText = this.bassThreshold;
                });

                document.getElementById('scale-slider').addEventListener('input', (e) => {
                    this.visualScale = parseFloat(e.target.value);
                    document.getElementById('scale-val').innerText = this.visualScale.toFixed(1);
                });

                document.getElementById('viz-mode-select').addEventListener('change', (e) => {
                    this.vizMode = e.target.value;
                });

                // Recording
                document.getElementById('record-btn').addEventListener('click', () => {
                    this.toggleRecording();
                });
            }

            // --- Dominant Color Extraction ---
            async extractVideoColor(videoUrl) {
                return new Promise((resolve) => {
                    const tempVid = document.createElement('video');
                    tempVid.src = videoUrl;
                    tempVid.muted = true;
                    tempVid.currentTime = 1.0;
                    tempVid.addEventListener('seeked', () => {
                        this.offCtx.drawImage(tempVid, 0, 0, 16, 16);
                        const imgData = this.offCtx.getImageData(0, 0, 16, 16).data;
                        let r = 0, g = 0, b = 0;
                        for (let i = 0; i < imgData.length; i += 4) {
                            r += imgData[i];
                            g += imgData[i + 1];
                            b += imgData[i + 2];
                        }
                        let count = imgData.length / 4;
                        r = Math.floor(r / count);
                        g = Math.floor(g / count);
                        b = Math.floor(b / count);
                        let [h, s, l] = rgbToHsl(r, g, b);
                        let group = getHueGroup(h);
                        resolve({ colorGroup: group, hue: h, hsl: `hsl(${h}, ${Math.round(s*100)}%, ${Math.round(l*100)}%)` });
                    });
                    tempVid.addEventListener('error', () => {
                        resolve({ colorGroup: 'Cyan', hue: 180, hsl: 'hsl(180, 100%, 50%)' });
                    });
                });
            }

            // --- Video Seamless Crossfader ---
            triggerVideoSwitch(targetIndex) {
                if (this.videoClips.length === 0) return;

                let nextClip = this.videoClips[targetIndex];
                let currentVideo = this.activeSlot === 1 ? this.v1 : this.v2;
                let nextVideo = this.activeSlot === 1 ? this.v2 : this.v1;

                nextVideo.src = nextClip.url;
                nextVideo.play().then(() => {
                    nextVideo.classList.add('active');
                    currentVideo.classList.remove('active');
                    this.activeSlot = this.activeSlot === 1 ? 2 : 1;
                    this.currentClipIndex = targetIndex;

                    // Update UI Badge
                    const badge = document.getElementById('color-badge');
                    badge.innerText = `${nextClip.colorGroup} Harmonic`;
                    badge.style.color = nextClip.hsl;
                }).catch(e => console.log("Video Play Transition Interrupted", e));
            }

            triggerHarmonicVideoSwitch() {
                if (this.videoClips.length <= 1) return;

                let currentClip = this.videoClips[this.currentClipIndex] || this.videoClips[0];
                let allowedGroups = COLOR_NEIGHBORS[currentClip.colorGroup] || COLOR_GROUPS;

                // Find candidate matching current or neighboring color groups
                let matches = [];
                this.videoClips.forEach((clip, idx) => {
                    if (idx !== this.currentClipIndex && allowedGroups.includes(clip.colorGroup)) {
                        matches.push(idx);
                    }
                });

                let nextIndex = matches.length > 0 
                    ? matches[Math.floor(Math.random() * matches.length)]
                    : (this.currentClipIndex + 1) % this.videoClips.length;

                this.triggerVideoSwitch(nextIndex);
            }

            // --- Tap Tempo & Beat Detection ---
            registerTapTempo() {
                const now = performance.now();
                this.tapTimes.push(now);
                if (this.tapTimes.length > 4) this.tapTimes.shift();

                if (this.tapTimes.length > 1) {
                    let intervals = [];
                    for (let i = 1; i < this.tapTimes.length; i++) {
                        intervals.push(this.tapTimes[i] - this.tapTimes[i - 1]);
                    }
                    let avgInterval = intervals.reduce((a, b) => a + b) / intervals.length;
                    this.bpm = Math.round(60000 / avgInterval);
                    this.beatCooldown = (60000 / this.bpm) * 0.6;
                    document.getElementById('bpm-badge').innerText = `${this.bpm} BPM`;
                }
            }

            checkBeatTrigger(freqData) {
                // Compute Bass Energy (Bins 0 to 8)
                let bassSum = 0;
                for (let i = 0; i < 8; i++) {
                    bassSum += freqData[i];
                }
                let avgBass = bassSum / 8;

                const now = performance.now();
                if (avgBass > this.bassThreshold && (now - this.lastBeatTime) > this.beatCooldown) {
                    this.lastBeatTime = now;
                    this.onBeatDetected();
                }
            }

            onBeatDetected() {
                // Pulse Canvas scale or trigger video swap if auto-swap enabled
                if (this.autoSwap && Math.random() > 0.6) {
                    this.triggerHarmonicVideoSwitch();
                }

                // Particle explosion on beat
                this.particles.forEach(p => {
                    p.vx += (Math.random() - 0.5) * 8;
                    p.vy += (Math.random() - 0.5) * 8;
                });
            }

            // --- Particle Physics System ---
            initParticles() {
                this.particles = [];
                for (let i = 0; i < 60; i++) {
                    this.particles.push({
                        x: Math.random(),
                        y: Math.random(),
                        vx: (Math.random() - 0.5) * 0.002,
                        vy: (Math.random() - 0.5) * 0.002,
                        radius: Math.random() * 4 + 2
                    });
                }
            }

            // --- Render Loop ---
            render() {
                this.audio.updateData();
                const freq = this.audio.freqData;
                const time = this.audio.timeData;

                if (freq) {
                    this.checkBeatTrigger(freq);
                }

                // Clear Canvas
                this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

                // Render Selected Visualizer Mode
                if (freq && time) {
                    const cx = this.canvas.width / 2;
                    const cy = this.canvas.height / 2;

                    switch (this.vizMode) {
                        case 'ring':
                            this.drawSmoothRing(cx, cy, freq);
                            break;
                        case 'line':
                            this.drawSharpLine(time);
                            break;
                        case 'bars':
                            this.drawSpectrumBars(freq);
                            break;
                        case 'particles':
                            this.drawParticlePhysics(freq);
                            break;
                    }
                }

                requestAnimationFrame(this.render);
            }

            // --- Visualizer Rendering Modes ---
            drawSmoothRing(cx, cy, freqData) {
                const baseRadius = Math.min(cx, cy) * 0.35 * this.visualScale;
                const numPoints = freqData.length;
                const angleStep = (Math.PI * 2) / numPoints;

                this.ctx.beginPath();
                this.ctx.lineWidth = 4;
                this.ctx.strokeStyle = 'rgba(0, 243, 255, 0.85)';
                this.ctx.shadowBlur = 16;
                this.ctx.shadowColor = '#00f3ff';

                for (let i = 0; i < numPoints; i++) {
                    let amp = (freqData[i] / 255) * 80 * this.visualScale;
                    let r = baseRadius + amp;
                    let angle = i * angleStep;
                    let x = cx + Math.cos(angle) * r;
                    let y = cy + Math.sin(angle) * r;

                    if (i === 0) this.ctx.moveTo(x, y);
                    else this.ctx.lineTo(x, y);
                }
                this.ctx.closePath();
                this.ctx.stroke();
                this.ctx.shadowBlur = 0;
            }

            drawSharpLine(timeData) {
                const w = this.canvas.width;
                const h = this.canvas.height;
                const sliceWidth = w / timeData.length;

                this.ctx.lineWidth = 3;
                this.ctx.strokeStyle = 'rgba(255, 0, 85, 0.9)';
                this.ctx.shadowBlur = 12;
                this.ctx.shadowColor = '#ff0055';
                this.ctx.beginPath();

                let x = 0;
                for (let i = 0; i < timeData.length; i++) {
                    let v = timeData[i] / 128.0;
                    let y = (v * h) / 2;

                    if (i === 0) this.ctx.moveTo(x, y);
                    else this.ctx.lineTo(x, y);

                    x += sliceWidth;
                }
                this.ctx.stroke();
                this.ctx.shadowBlur = 0;
            }

            drawSpectrumBars(freqData) {
                const w = this.canvas.width;
                const h = this.canvas.height;
                const barCount = freqData.length / 2;
                const barWidth = (w / barCount) * 0.8;
                let x = 0;

                for (let i = 0; i < barCount; i++) {
                    let barHeight = (freqData[i] / 255) * h * 0.4 * this.visualScale;
                    let gradient = this.ctx.createLinearGradient(0, h, 0, h - barHeight);
                    gradient.addColorStop(0, '#00ff88');
                    gradient.addColorStop(1, '#00f3ff');

                    this.ctx.fillStyle = gradient;
                    this.ctx.fillRect(x, h - barHeight, barWidth, barHeight);

                    x += barWidth + 4;
                }
            }

            drawParticlePhysics(freqData) {
                const w = this.canvas.width;
                const h = this.canvas.height;
                const bassVal = freqData[2] / 255;

                this.particles.forEach((p) => {
                    p.x += p.vx * (1 + bassVal * 2);
                    p.y += p.vy * (1 + bassVal * 2);

                    if (p.x < 0) p.x = 1;
                    if (p.x > 1) p.x = 0;
                    if (p.y < 0) p.y = 1;
                    if (p.y > 1) p.y = 0;

                    this.ctx.beginPath();
                    this.ctx.arc(p.x * w, p.y * h, p.radius * (1 + bassVal * 1.5) * this.visualScale, 0, Math.PI * 2);
                    this.ctx.fillStyle = `rgba(0, 243, 255, ${0.4 + bassVal * 0.6})`;
                    this.ctx.fill();
                });
            }

            // --- Media Recording Export ---
            toggleRecording() {
                const recordBtn = document.getElementById('record-btn');
                if (this.isRecording) {
                    this.mediaRecorder.stop();
                    this.isRecording = false;
                    recordBtn.classList.remove('recording');
                    recordBtn.innerText = '🔴 Record Mix';
                } else {
                    this.recordedChunks = [];
                    const canvasStream = this.canvas.captureStream(30);

                    // Combine Canvas video stream + Web Audio destination audio stream
                    const combinedStream = new MediaStream();
                    canvasStream.getVideoTracks().forEach(track => combinedStream.addTrack(track));

                    if (this.audio.destNode) {
                        this.audio.destNode.stream.getAudioTracks().forEach(track => combinedStream.addTrack(track));
                    }

                    this.mediaRecorder = new MediaRecorder(combinedStream, { mimeType: 'video/webm' });
                    this.mediaRecorder.ondataavailable = (e) => {
                        if (e.data.size > 0) this.recordedChunks.push(e.data);
                    };
                    this.mediaRecorder.onstop = () => {
                        const blob = new Blob(this.recordedChunks, { type: 'video/webm' });
                        const url = URL.createObjectURL(blob);
                        const a = document.createElement('a');
                        a.href = url;
                        a.download = `VJ_Mix_${Date.now()}.webm`;
                        a.click();
                    };

                    this.mediaRecorder.start();
                    this.isRecording = true;
                    recordBtn.classList.add('recording');
                    recordBtn.innerText = '⏹️ Stop Recording';
                }
            }
        }

        // Initialize App on DOM Ready
        window.addEventListener('DOMContentLoaded', () => {
            const app = new VJStudioApp();
            app.init();
        });
    </script>
</body>
